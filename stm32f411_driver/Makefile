##############################################################################
# Bare-metal build for STM32F411VET6 (32F411EDISCOVERY)
#
#   make            -> build/main.elf + .bin + .hex + .map
#   make size       -> section sizes
#   make flash      -> st-flash write build/main.bin to 0x08000000
#   make flash-ocd  -> same, but via openocd (program + verify + reset)
#   make openocd    -> start GDB server on :3333 (then use gdb-multiarch)
#   make clean
#
# NOTE: recipes use REAL TABS. If you see "missing separator", check that.
##############################################################################

TARGET    := main
BUILD_DIR := build
LDSCRIPT  := linker.ld
FLASH_ADDR := 0x08000000

##############################################################################
# Tools
##############################################################################
CC      := arm-none-eabi-gcc
OBJCOPY := arm-none-eabi-objcopy
OBJDUMP := arm-none-eabi-objdump
SIZE    := arm-none-eabi-size
GDB     := gdb-multiarch

# openocd with the on-board ST-LINK/V2-A, SWD. This pair of configs is the
# generic one; it works for the F411 too (target/stm32f4x.cfg autodetects).
OPENOCD     := openocd
OPENOCD_ARGS := -f interface/stlink.cfg -f target/stm32f4x.cfg

##############################################################################
# Flags
##############################################################################
# cortex-m4 = the core in the F411, -mthumb = only Thumb-2 on M-class.
# -mfloat-abi=soft: no FPU instructions are emitted, so we do NOT have to
# enable the FPU (CPACR) in startup.s. Switch to hard + CPACR later, on purpose.
MCU := -mcpu=cortex-m4 -mthumb -mfloat-abi=soft

# -O0 -g3: easiest to single-step in GDB while learning. Raise to -Og/-O2 later.
OPT := -O0 -g3

C_DEFS     :=
C_INCLUDES := -IDrivers/Inc

# -ffunction-sections/-fdata-sections + --gc-sections = drop unused code
CFLAGS := $(MCU) $(C_DEFS) $(C_INCLUDES) $(OPT) \
          -std=c11 -Wall -Wextra \
          -ffunction-sections -fdata-sections
ASFLAGS := $(MCU) $(OPT) -Wall

# -nostdlib: no crt0, no libc, no libgcc -> our startup.s and main() are the
# only entry points. -T linker.ld tells ld about FLASH/RAM and _estack.
LDFLAGS := $(MCU) -T$(LDSCRIPT) -nostdlib \
           -Wl,-Map=$(BUILD_DIR)/$(TARGET).map,--cref \
           -Wl,--gc-sections \
           -Wl,--print-memory-usage

##############################################################################
# Sources / objects
##############################################################################
# wildcard -> every .c in the project root and in Drivers/Src.
# Add new drivers to Drivers/Src and they are picked up automatically.
C_SOURCES   := $(wildcard *.c) $(wildcard Drivers/Src/*.c)
ASM_SOURCES := $(wildcard *.s)

OBJECTS := $(addprefix $(BUILD_DIR)/,$(notdir $(C_SOURCES:.c=.o))) \
           $(addprefix $(BUILD_DIR)/,$(notdir $(ASM_SOURCES:.s=.o)))
vpath %.c $(sort $(dir $(C_SOURCES)))
vpath %.s $(sort $(dir $(ASM_SOURCES)))

# .d files are generated by -MMD and hold "which headers does this .o need"
DEPS := $(OBJECTS:.o=.d)

##############################################################################
# Rules
##############################################################################
.PHONY: all clean size flash flash-ocd openocd reset bin hex

all: $(BUILD_DIR)/$(TARGET).elf $(BUILD_DIR)/$(TARGET).bin $(BUILD_DIR)/$(TARGET).hex

$(BUILD_DIR)/%.o: %.c Makefile | $(BUILD_DIR)
	$(CC) -c $(CFLAGS) -MMD -MP $< -o $@

$(BUILD_DIR)/%.o: %.s Makefile | $(BUILD_DIR)
	$(CC) -c $(ASFLAGS) $< -o $@

$(BUILD_DIR)/$(TARGET).elf: $(OBJECTS) $(LDSCRIPT)
	$(CC) $(OBJECTS) $(LDFLAGS) -o $@
	$(SIZE) $@

$(BUILD_DIR)/%.bin: $(BUILD_DIR)/%.elf
	$(OBJCOPY) -O binary $< $@

$(BUILD_DIR)/%.hex: $(BUILD_DIR)/%.elf
	$(OBJCOPY) -O ihex $< $@

$(BUILD_DIR):
	mkdir -p $@

size: $(BUILD_DIR)/$(TARGET).elf
	$(SIZE) -A -x $<

disasm: $(BUILD_DIR)/$(TARGET).elf
	$(OBJDUMP) -d $< | head -80

# st-flash needs permission on the USB device; add the 49-stlink-udev-rules
# udev rule to avoid sudo.
flash: $(BUILD_DIR)/$(TARGET).bin
	st-flash --reset write $< $(FLASH_ADDR)

flash-ocd: $(BUILD_DIR)/$(TARGET).elf
	$(OPENOCD) $(OPENOCD_ARGS) -c "program $< verify reset exit"

openocd:
	$(OPENOCD) $(OPENOCD_ARGS)

clean:
	rm -rf $(BUILD_DIR)

-include $(DEPS)

